{
  "name": "vr-menu",
  "version": "1.0.0",
  "description": "Віртуальне меню ресторану в VR/AR (WebXR) з керуванням поглядом, променем, жестами й голосом (лабораторна робота №4)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "postinstall": "node scripts/download-model.js",
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:e2e": "node test/e2e/browser.mjs",
    "test:e2e:eyes": "node test/e2e/eyes.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "express": "^4.21.2",
    "three": "^0.186.1"
  }
}
